APP_NAME="Eventos IPCCG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Conexão operacional (default): este app ──
# Produção cPanel: prefira DB_HOST=localhost (socket Unix, menos latência).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ipccgorg_Eventos
DB_USERNAME=
DB_PASSWORD=

# ── Conexão centralizadora: congregações (multi-tenant) ──
# Mesmo servidor/usuário do banco operacional; só o schema muda. Só defina as
# DB_MODERN_APPS_* abaixo se o banco central exigir credenciais próprias —
# caso contrário, herdam de DB_* automaticamente.
DB_MODERN_APPS_DATABASE=ipccgorg_ModernApps
# DB_MODERN_APPS_HOST=
# DB_MODERN_APPS_USERNAME=
# DB_MODERN_APPS_PASSWORD=

# Sessão, cache e fila em arquivo: não exigem banco nem redis (padrão do
# EscalaMembros, que roda bem no cPanel).
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# DEV: MAIL_MAILER=log (e-mails vão para storage/logs).
# PRODUÇÃO (cPanel): MAIL_MAILER=smtp e preencha MAIL_PASSWORD.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=mail.ipccg.org.br
MAIL_PORT=465
MAIL_USERNAME=ti@ipccg.org.br
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="ti@ipccg.org.br"
MAIL_FROM_NAME="Eventos IPCCG"
